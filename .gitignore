node_modules
dist

# Holds the licence endpoint and public key. Neither is secret - both ship in
# the bundle - but .env is where a private key gets pasted by mistake, so it
# stays out of the repo and .env.example carries the shape instead.
.env
.env.local
.env.*.local

# Batch CSVs from license_codes.mjs. These ARE the sellable codes and the only
# copy of them: the server stores hashes. Keep them somewhere backed up, never
# in the repository.
codes-*.csv

# Wrangler's local D1 state, and the local copies of the Worker's secrets that
# `wrangler dev` reads instead of the deployed ones.
worker/node_modules
worker/.wrangler
worker/.dev.vars


# Android bundles built for upload to Google Play
release/
