# Copy to .env (gitignored) and fill in from AdMob (apps > PlayGoo > App settings
# and Ad units). None of these is secret - they ship inside the app - but .env
# keeps them out of builds that should show test ads: without them, the app
# asks for Google's test ads, and android_build.mjs refuses to make a release.
ADMOB_APP_ID=ca-app-pub-0000000000000000~0000000000
VITE_ADMOB_BANNER_ID=ca-app-pub-0000000000000000/0000000000
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-0000000000000000/0000000000
