# Copy to .env and fill in. Everything here is baked into the bundle at build
# time, so none of it is a secret - the public key is meant to be readable, and
# the endpoint is one the app calls from a browser anyway. The private key that
# matches VITE_LICENSE_PUBLIC_KEY lives only as a Cloudflare secret on the
# Worker; it must never appear in this file.
#
# `node license_setup.mjs` fills in VITE_LICENSE_PUBLIC_KEY for you, sets the
# matching secrets on the Worker, and checks the pair end to end. Set
# VITE_ACTIVATION_URL first - the check needs it. See worker/README.md.

# Where a code is redeemed. One POST, once, and then never again.
VITE_ACTIVATION_URL=https://nauka-liter-licence.YOUR-SUBDOMAIN.workers.dev/activate

# Base64 SPKI public key. The app verifies every licence token against this on
# every launch, offline. A build without it locks rather than trusting whatever
# is in storage, so a missing value fails loudly instead of shipping unlocked.
VITE_LICENSE_PUBLIC_KEY=

# Optional. Shown on the activation screen so a parent whose code will not work
# has somewhere to write. Left empty, the contact lines are simply not rendered.
VITE_SUPPORT_EMAIL=

# Development only. `npm run dev` skips the gate when this is true; it cannot do
# anything in a production build, because the flag is ANDed with import.meta.env.DEV,
# which Vite replaces with a literal false in `vite build` and drops the branch.
VITE_LICENSE_DEV_BYPASS=true
